# 복사해서 .env.prod 로 만들고 실제 값을 채운다. (.env.* 는 git 에 올리지 않는다)
# 값에 '$' 문자가 있으면 '$$' 로 써야 compose 가 변수로 해석하지 않는다.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=eatsadeal            # root 는 사용 불가 (MySQL 이미지 제약)
DB_PASSWORD=change-me-db

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- JWT (HS256: 32바이트 이상의 랜덤 문자열) ---
JWT_SECRET=change-me-at-least-32-bytes-random-string
JWT_EXPIRATION_MS=3600000

# --- 메일 (Gmail 앱 비밀번호) ---
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password
REPORT_MAIL_TO=receiver@example.com

# --- 최초 관리자 계정 (비워 두면 생성하지 않음) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 선택 ---
HTTP_PORT=80
